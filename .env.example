# NOVA — copy to .env.local and fill in real values. NEVER commit .env.local.

# PostgreSQL connection string
# Local development with Docker Compose (docker compose up -d postgres):
DATABASE_URL="postgresql://nova:changeme@localhost:5433/nova?schema=public"

# JWT secrets — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Only NEXT_PUBLIC_* vars are exposed to the browser.
# No secrets should ever use this prefix.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

NODE_ENV="development"
