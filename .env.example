# NOVA environment — copy to .env and fill in real values. NEVER commit .env.
# Local development with Docker Compose (docker compose up -d postgres):
DATABASE_URL="postgresql://nova:nova_dev_password@localhost:5433/nova?schema=public"

# JWT secrets — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

NODE_ENV="development"
