# NOVA Environment Variables Template
# Copy this file to .env for local development: cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# - NEVER commit .env or real secrets to source control.
# - Production secrets must be configured in the hosting platform environment settings (e.g. Vercel).
# - JWT_ACCESS_SECRET and JWT_REFRESH_SECRET must be different, secure, random strings.
# - NEXT_PUBLIC_* values are browser-exposed and must NEVER contain sensitive secrets or tokens.

# Local development database (PostgreSQL exposed on port 5433 by docker-compose)
DATABASE_URL="postgresql://nova:nova_dev_password@localhost:5433/nova?schema=public"

# JWT Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Token lifetimes
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Public site URL (browser-exposed, no secrets)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

NODE_ENV="development"

