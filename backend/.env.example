# NOVA backend — copy to .env and fill in real values. NEVER commit .env.
# See backend/.env.example for the canonical list.

# PostgreSQL connection (Prisma). Example:
# postgresql://nova:nova_dev_password@localhost:5432/nova?schema=public
DATABASE_URL="postgresql://nova:changeme@localhost:5432/nova?schema=public"

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="changeme-access-secret-min-32-chars"
JWT_REFRESH_SECRET="changeme-refresh-secret-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

PORT="4000"
NODE_ENV="development"
FRONTEND_ORIGIN="http://localhost:5173"
